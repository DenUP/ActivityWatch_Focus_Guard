{
  "manifest_version": 3,
  "name": "Focus Guard — блокировка YouTube",
  "description": "Блокирует YouTube во время учебной сессии Focus Guard на этом компьютере.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "permissions": ["declarativeNetRequest", "alarms", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://youtube-nocookie.com/*",
    "*://*.youtube-nocookie.com/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_popup": "popup.html" },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js"],
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://youtube-nocookie.com/*",
        "*://*.youtube-nocookie.com/*"
      ]
    }
  ]
}
